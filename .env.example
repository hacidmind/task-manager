# Required online MongoDB connection string (replace placeholders in .env.local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/

# Database name
MONGODB_DB=task_manager

# Reserved for future OTP use. Email OTP is currently disabled; these are not required.
RESEND_API_KEY=
EMAIL_FROM=Momentum <login@your-verified-domain.com>
