{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": "./*",
            "@/components/*": [
                "./components/*"
            ],
            "@/pages/*": [
                "./pages/*"
            ],
            "@/lib/*": [
                "./lib/*"
            ],
            "@/styles/*": [
                "./styles/*"
            ]
        }
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx"
    ]
}